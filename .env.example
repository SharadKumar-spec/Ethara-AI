# =====================================================================
# Database Configuration (PostgreSQL)
# =====================================================================
# Use this when running locally without docker-compose:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_db

# Use this for docker-compose:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/inventory_db

# Credentials for the database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory_db

# =====================================================================
# Frontend Configuration (Vite + React)
# =====================================================================
# Target URL for API requests.
# Point this to localhost if running the dev server locally, or to the backend service name if in Docker.
VITE_API_URL=http://localhost:8000/api
